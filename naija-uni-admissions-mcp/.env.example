# Crawl4AI runs locally via Playwright/Chromium - no API key needed.
# Keep this file for NGN_PER_USD, run caps, and Supabase config.

# NGN -> USD conversion rate used in fees_parser.py
NGN_PER_USD=1600

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: max pages per single invocation (0 = unlimited)
MAX_PAGES_PER_RUN=0

# ============================================================================
# SUPABASE CONFIGURATION (required for production knowledge base)
# Get these from your Supabase project dashboard: Settings > API
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage bucket for crawl artifacts (HTML, PDF, screenshots, markdown)
SUPABASE_STORAGE_BUCKET=crawl-assets

# ============================================================================
# S3-COMPATIBLE STORAGE (optional - for self-hosted MinIO or AWS S3)
# If not set, uses Supabase Storage via S3 API
# ============================================================================
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_REGION=us-east-1
# CRAWL_ASSETS_BUCKET=crawl-assets
# INSTITUTION_ASSETS_BUCKET=institution-assets

# ============================================================================
# NVIDIA NIM / QWEN (for AI-powered extraction - Phase 2)
# ============================================================================
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
# NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1
# QWEN_MODEL=nvidia/nemotron-3-ultra

# ============================================================================
# CRAWL POLICY (Phase 3)
# ============================================================================
# CRAWL_MODE=full_annual  # full_annual | single_institution | selected_institutions | force_refresh
# TARGET_INSTITUTIONS=University of Ibadan,University of Lagos
# RESUME_FROM_CHECKPOINT=true